{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Driftlet",
  "version": "1.0.0",
  "identifier": "com.driftlet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: skin: http://skin.localhost https://skin.localhost; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "icons/dskin.ico": "dskin.ico" },
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["dskin"],
        "name": "Driftlet Skin Package",
        "description": "Driftlet Skin Package"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
