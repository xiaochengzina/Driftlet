{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Driftlet",
  "version": "1.2.7",
  "identifier": "com.driftlet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: skin: http://skin.localhost https://skin.localhost; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Driftlet",
    "copyright": "Copyright © 2026 Driftlet",
    "shortDescription": "Driftlet — Windows 桌面皮肤挂件平台",
    "longDescription": "Driftlet 是一款 Windows 桌面皮肤管理器：以桌面小部件形式呈现网页皮肤，提供透明无边框窗口、置顶、贴桌面、边缘吸附等能力，随安装包内置屿族官方皮肤。",
    "resources": {
      "icons/dskin.ico": "dskin.ico",
      "../examples/isles-countdown": "bundled-skins/isles-countdown",
      "../examples/isles-calendar": "bundled-skins/isles-calendar",
      "../examples/isles-clock": "bundled-skins/isles-clock",
      "../examples/isles-monitor": "bundled-skins/isles-monitor",
      "../examples/isles-weather": "bundled-skins/isles-weather",
      "../examples/isles-timer": "bundled-skins/isles-timer"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "minimumWebview2Version": "111.0.0.0",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["dskin"],
        "name": "Driftlet Skin Package",
        "description": "Driftlet Skin Package"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
